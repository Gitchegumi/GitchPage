# Next.js Configuration
NEXT_PUBLIC_SITE_URL=https://www.gitchegumi.com
NEXT_PUBLIC_N8N_SUBSCRIBE_URL=your_n8n_subscribe_url_here

# Webhook secret — set this to a random string and add it as a GitHub Actions secret
WEBHOOK_SECRET=

# Voiceover Inquiry Form
# Public Node-RED endpoint injected at build time for GitHub Pages.
# The private Twenty CRM webhook is configured only in Node-RED.
NEXT_PUBLIC_VO_FORM_ENDPOINT=https://node.example.com/vo-inquiry

# Ghost CMS
GHOST_URL=https://blog.gitchegumi.com
GHOST_CONTENT_API_KEY=your_ghost_content_api_key_here
